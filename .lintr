linters: linters_with_defaults(
  indentation_linter = indentation_linter(indent = 2),
  line_length_linter = NULL,
  object_name_linter = object_name_linter(
    styles = c("snake_case", "camelCase", "dotted.case", "symbols"),
    regexes = c(internal = "^\\.[A-Za-z][A-Za-z0-9._]*$")
  ),
  object_usage_linter = NULL
  )
exclusions: list(
  "man",
  "docs"
  )
encoding: "UTF-8"
